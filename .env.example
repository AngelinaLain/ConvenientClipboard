# Run scripts/init-env.ps1 (Windows) or scripts/init-env.sh (Linux/macOS)
# to generate .env with unique credentials. Never commit .env.
APP_PORT=8088
APP_BIND_ADDRESS=127.0.0.1
APP_PUBLIC_BASE_URL=http://localhost:8088
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-strong-password
APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_STORAGE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_PASSWORD=replace-with-a-random-password
# Enable when serving through HTTPS. Local HTTP requires false.
APP_COOKIE_SECURE=false
# Initial single-file limit only; administrator settings take precedence once saved.
# Range: 1 MiB (1048576) through 100 GiB (107374182400).
APP_MAX_UPLOAD_BYTES=1073741824
